#!/usr/bin/env bash
# Refuse a commit on a protected branch, and a commit whose staged tree fails
# the runner's own tests when it touches runner/.
#
# This is the state-based half of the layering the CH-8 retrospective produced.
# It never sees the command that produced the commit, so it cannot be spelled
# around: eval, sh -c, a script file, xargs, an inline alias and a line
# continuation are all identical by the time git runs this. The PreToolUse text
# guard permitted 9 of 11 of those; this stops them because it asks git rather
# than reading a string.
#
# What it deliberately does not claim to stop:
#   git commit --no-verify   skips every local hook, by design
#   git commit-tree          plumbing does not run hooks at all
# Both are recorded in shared/bypass-corpus.json as stopped_by: server. Branch
# protection remains the authoritative layer; this is enforcement, not authority.
#
# Installed by helpers/install-git-hooks.sh, which sets core.hooksPath.
set -uo pipefail

PROTECTED_DEFAULT="main master"
protected="${GIT_PROTECTED_BRANCHES:-$PROTECTED_DEFAULT}"

# An unborn HEAD is the first commit in a fresh repository. Refusing it would
# make new repos impossible to start, and a hook that blocks ordinary work is a
# hook that gets uninstalled -- which costs more than it saves.
if ! git rev-parse --verify --quiet HEAD >/dev/null 2>&1; then
  exit 0
fi

# CE-2.95 (Patrick's yes on CH-189). A commit that stages anything under
# runner/ runs the runner's test suite, and is refused unless it passes. The
# CSO's list review (2026-09-27) shaped each part:
#   - It judges the STAGED tree: the whole index is exported into a temporary
#     directory, because the commit ships the index, not the working tree. The
#     whole index, not runner/ alone: the runner's ConstraintTests find the repo
#     root by its .git directory and scan every file in the repo, so the export
#     carries an empty .git marker at its root.
#   - This file has no `set -e` and ends in `exit 0`, so every failure below
#     exits 1 itself: no dotnet, no solution in the staged tree, an export that
#     fails, a failing suite, or the time bound.
#   - --no-renames turns a rename into a delete plus an add, so moving a file
#     into or out of runner/ triggers it; the match is anchored at "runner/".
#   - A time bound, and no build server or MSBuild node outlives the hook.
# Known limits: the repo-wide constraint scan runs only when runner/ changes, so
# a change elsewhere that would start the runner is judged the next time
# runner/ changes, not at its own commit; and merge, rebase and cherry-pick
# commits never run pre-commit, like --no-verify and commit-tree above.
# It runs before the detached-HEAD exit below, so no branch state skips it.
# The CH-167 constraint tests this gate exists for (CH-189). `dotnet test`
# exits 0 when NO test runs -- an emptied test project, or a solution that no
# longer holds it -- so the gate also requires each of these to have passed by
# name (the CSO's change review, finding 1). Renaming one means changing it
# here too, which is the point.
RUNNER_REQUIRED_TESTS="
HarnessRunner.Tests.ConstraintTests.Nothing_makes_the_runner_start_without_Patrick
HarnessRunner.Tests.ConstraintTests.No_process_is_started_from_a_concatenated_command_line
HarnessRunner.Tests.ConstraintTests.The_request_carries_a_key_and_nothing_that_could_become_a_command
HarnessRunner.Tests.ConstraintTests.The_scan_actually_reads_files
"

# Global, not local to runner_gate: the EXIT trap fires after the function has
# returned, when a local would already be gone (the change review, finding 2).
runner_tmp=""
runner_gate() {
  local changed staged out rc name
  # A failing `git diff` must refuse, not read as "nothing staged under
  # runner/" (the change review, finding 4).
  if ! changed=$(git diff --cached --name-only --no-renames); then
    echo "pre-commit: refusing: git could not list the staged paths, so the runner gate cannot decide." >&2
    exit 1
  fi
  staged=$(printf '%s\n' "$changed" | grep -E '^runner/' || true)
  [ -n "$staged" ] || return 0

  if ! command -v dotnet >/dev/null 2>&1; then
    echo "pre-commit: refusing: this commit stages runner/, and dotnet is not on PATH, so the runner's tests cannot run." >&2
    exit 1
  fi

  runner_tmp=$(mktemp -d) || {
    echo "pre-commit: refusing: no temporary directory for the runner's tests." >&2
    exit 1
  }
  trap 'rm -rf "$runner_tmp"' EXIT

  if ! git checkout-index -a --prefix="$runner_tmp/" || ! mkdir "$runner_tmp/.git"; then
    echo "pre-commit: refusing: the staged tree could not be exported for the runner's tests." >&2
    exit 1
  fi
  if [ ! -f "$runner_tmp/runner/HarnessRunner.sln" ]; then
    echo "pre-commit: refusing: runner/HarnessRunner.sln is not in the staged tree, so the runner's tests cannot run." >&2
    exit 1
  fi

  out="$runner_tmp/.runner-tests.log"
  # UseSharedCompilation must be in the environment as well as a -p: switch:
  # with the switch alone, a VBCSCompiler server outlived every run (measured
  # 2026-09-27, `ps` after the hook exited). Normal console verbosity prints
  # one "Passed <name>" line per test, which the required-test check reads.
  UseSharedCompilation=false MSBUILDDISABLENODEREUSE=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    timeout 300 dotnet test "$runner_tmp/runner/HarnessRunner.sln" \
      --nologo --disable-build-servers -nodeReuse:false \
      -p:UseSharedCompilation=false -p:UseRazorBuildServer=false \
      --logger "console;verbosity=normal" > "$out" 2>&1
  rc=$?
  if [ "$rc" -eq 124 ]; then
    echo "pre-commit: refusing: the runner's tests did not finish within 300 s." >&2
    exit 1
  fi
  if [ "$rc" -ne 0 ]; then
    echo "pre-commit: refusing: the runner's tests failed on the staged tree (dotnet test exit $rc). Last lines:" >&2
    tail -n 20 "$out" >&2
    exit 1
  fi
  for name in $RUNNER_REQUIRED_TESTS; do
    if ! grep -qE "^[[:space:]]*Passed ${name}( |\$)" "$out"; then
      echo "pre-commit: refusing: the runner's suite exited 0 but ${name} did not pass in it, so the constraint it enforces went unchecked." >&2
      exit 1
    fi
  done
}
runner_gate

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")

# A detached HEAD is not a protected branch and is usually a rebase or a
# bisect. Let it through rather than breaking those flows.
[ -z "$branch" ] && exit 0

# A repo's own hooks must keep running. Setting core.hooksPath REPLACES the
# hook path rather than adding to it, so installing this without chaining would
# silently disable whatever the repo already had -- a feature regression, and a
# silent one, which is the worst kind.
# NOTE: `git rev-parse --git-path hooks/pre-commit` HONOURS core.hooksPath, so it
# returns THIS file. Using it here called the hook from inside the hook, without
# bound: on 2026-08-08 that spawned processes until the editor died. Resolve the
# repo's own hooks through --git-dir, which hooksPath does not affect.
#
# The guard variable is a second, independent stop. One of these should be
# enough; a runaway that takes the machine down does not get to depend on that.
chain() {
  local own
  own="$(git rev-parse --git-dir 2>/dev/null)/hooks/pre-commit"
  [ -x "$own" ] || return 0
  [ "$(cd "$(dirname "$own")" && pwd)" = "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)" ] && return 0
  [ -n "${CLAUDE_SHARED_HOOK_RUNNING:-}" ] && return 0
  CLAUDE_SHARED_HOOK_RUNNING=1 "$own" "$@" || exit $?
}

for p in $protected; do
  if [ "$branch" = "$p" ]; then
    if [ -n "${ALLOW_PROTECTED_COMMIT:-}" ]; then
      echo "pre-commit: allowing a commit on '$branch' — ALLOW_PROTECTED_COMMIT=${ALLOW_PROTECTED_COMMIT}" >&2
      exit 0
    fi
    cat >&2 <<MSG
pre-commit: refusing a commit on '$branch'.

Nothing reaches a protected branch except through a pull request. Branch, then
open a PR:

  git switch -c <type>/<short-description>
  git commit ...

This hook reads the branch from git, not from your command, so there is no way
to phrase the commit that avoids it. If you genuinely need one -- bootstrapping
a repository, an import -- say so explicitly and it will be allowed:

  ALLOW_PROTECTED_COMMIT="<reason>" git commit ...

Using --no-verify instead disables every hook in this repository, which is
worse than the thing you are working around.
MSG
    exit 1
  fi
done

chain "$@"
exit 0
