#!/usr/bin/env bash
# Refuse a push whose destination is a protected branch.
#
# git hands this hook the resolved refs on stdin, one line per ref:
#
#   <local ref> <local sha> <remote ref> <remote sha>
#
# That is the fact, not the command. `git push origin develop:main`,
# `git push origin HEAD:main`, `git push --force origin +x:main` and
# `git push origin :main` all arrive here as a remote ref of refs/heads/main,
# which is why this cannot be spelled around the way a refspec regex can.
#
# The text guard needed a bespoke parser for each of those spellings and still
# missed forms. This needs none.
#
# Deliberately not claimed: --no-verify skips it. Branch protection on the
# remote is the authoritative layer and is unaffected.
set -uo pipefail

# The repo's own pre-push must keep running: core.hooksPath REPLACES the path
# rather than adding to it, so installing this without chaining would silently
# disable whatever was there. stdin is the ref list and can only be read once,
# so it is captured and replayed to the chained hook.
# --git-path hooks/... HONOURS core.hooksPath and would return THIS file, which
# is unbounded recursion. --git-dir does not.
own_hook="$(git rev-parse --git-dir 2>/dev/null)/hooks/pre-push"
shared_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ "$(cd "$(dirname "$own_hook")" 2>/dev/null && pwd)" = "$shared_dir" ] \
   || [ -n "${CLAUDE_SHARED_HOOK_RUNNING:-}" ]; then
  own_hook=""
fi
refs="$(cat)"

PROTECTED_DEFAULT="main master"
protected="${GIT_PROTECTED_BRANCHES:-$PROTECTED_DEFAULT}"
ZERO="0000000000000000000000000000000000000000"

refused=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${remote_ref:-}" ] && continue

  short="${remote_ref#refs/heads/}"
  for p in $protected; do
    [ "$short" = "$p" ] || continue

    if [ -n "${ALLOW_PROTECTED_PUSH:-}" ]; then
      echo "pre-push: allowing a push to '$short' — ALLOW_PROTECTED_PUSH=${ALLOW_PROTECTED_PUSH}" >&2
      continue
    fi

    if [ "$local_sha" = "$ZERO" ]; then
      what="delete '$short'"
    elif [ "$remote_sha" != "$ZERO" ] && \
         ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      what="force-push over '$short' (it would discard commits on the remote)"
    else
      what="push to '$short'"
    fi

    echo "pre-push: refusing to $what." >&2
    refused=1
  done
done <<<"$refs"

if [ "$refused" -eq 1 ]; then
  cat >&2 <<MSG

Nothing reaches a protected branch except through a pull request, and merges
happen on GitHub, not from a terminal.

  git push -u origin <your-branch>
  gh pr create --base main --head <your-branch>

This hook reads the refs git resolved, not your command line, so a refspec, a
force or a delete are all visible to it however they are written.

If you genuinely need one:

  ALLOW_PROTECTED_PUSH="<reason>" git push ...
MSG
  exit 1
fi

if [ -n "$own_hook" ] && [ -x "$own_hook" ]; then
  printf '%s\n' "$refs" | CLAUDE_SHARED_HOOK_RUNNING=1 "$own_hook" "$@" || exit $?
fi

exit 0
